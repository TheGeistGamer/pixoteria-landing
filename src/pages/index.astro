---
import '../styles/global.css';

export const prerender = true;
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/png" href="/images/icon.png" />
		<title>Pixotería — La lotería que se juega en tu mesa</title>
		<meta
			name="description"
			content="Lotería mexicana multijugador por WiFi local. Nueve barajas, sin cuentas, sin internet. Descubre Pixotería."
		/>
		<meta property="og:title" content="Pixotería — La lotería que se juega en tu mesa" />
		<meta
			property="og:description"
			content="Lotería mexicana multijugador por WiFi local. Nueve barajas, sin cuentas, sin internet."
		/>
		<meta property="og:image" content="/images/icon.png" />
		<meta property="og:type" content="website" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&display=swap"
		/>
	</head>
	<body>
		<div class="page">
			<header class="checker-bg topbar" id="topbar">
				<div class="topbar-inner">
					<a href="#inicio" class="pixel wordmark">PIXOTERÍA</a>
					<nav class="topnav">
						<a href="#mazos" class="pixel toplink">Mazos</a>
						<a href="#barajas" class="pixel toplink">Barajas</a>
						<a href="#capturas" class="pixel toplink">Capturas</a>
						<a href="#privacidad" class="pixel toplink">Privacidad</a>
						<a href="#soporte" class="pixel toplink">Soporte</a>
					</nav>
				</div>
			</header>

			<!-- HERO -->
			<section class="section hero" id="inicio">
				<div class="mx-auto max-w-7xl px-[25px] sm:px-8 md:px-12 lg:px-16 hero-grid">
					<div>
						<div class="eyebrow">Lotería mexicana · multijugador local</div>
						<h1 class="pixel hero-title">EL MAZO LO ELIGE<br />QUIEN INVITA</h1>
						<p class="hero-copy">
							Lo que escojas lo ven todos en tu mesa. Nueve barajas, cero
							cuentas, cero internet — solo tu WiFi y tu gente.
						</p>
						<div class="hero-buttons">
							<span class="btn-pixel btn-pixel--green btn-pixel--static">
								<svg
									width="20"
									height="20"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									><path
										d="M16 3c0 2-1.5 4-4 4S8 5 8 3M6 8c1-1.5 3-2 6-2s5 .5 6 2c1.2 1.6 2 4 2 7 0 5-3 9-8 9s-8-4-8-9c0-3 .8-5.4 2-7z"
									></path></svg
								>
								Próximamente · App Store
							</span>
							<span class="btn-pixel btn-pixel--play btn-pixel--static">
								<svg
									width="20"
									height="20"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"><path d="M4 3l16 9-16 9V3z"></path></svg
								>
								Próximamente · Google Play
							</span>
						</div>
						<div class="pixel hero-tag">9 BARAJAS · 100% LOCAL · SIN CUENTAS</div>
					</div>

					<div class="hero-scene">
						<img
							src="/images/cards/hero-fan.jpg"
							alt="Abanico de cartas de lotería de Pixotería: El Mercado, La Ofrenda y más"
							class="hero-scene-img"
						/>
					</div>
				</div>
			</section>

			<!-- GOLD BADGE STRIP -->
			<section class="checker-gold section badge-section" id="mazos">
				<div class="mx-auto max-w-7xl px-[25px] sm:px-8 md:px-12 lg:px-16">
					<div class="center">
						<h2 class="pixel badge-heading">ELIGE TU MAZO</h2>
						<p class="body-copy centered-copy badge-subcopy">
							54 personajes por baraja. Desliza para ver las 9 — la que elijas
							la ven todos en tu mesa.
						</p>
					</div>
					<div class="badge-strip-wrap">
						<div class="badge-arrow">
							<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"
								><path d="M15 6l-6 6 6 6"></path></svg
							>
						</div>
						<div class="badge-strip">
							<div class="badge-item">
								<div class="card-thumb">
									<img src="/images/cards/perrault-zapato-cristal.png" alt="Carta El Zapato de Cristal, del mazo Cuentos de Perrault" />
								</div>
								<div class="deck-name">Perrault</div>
								<div class="deck-desc">Cenicienta, Caperucita, El Gato con Botas y más.</div>
							</div>
							<div class="badge-item">
								<div class="card-thumb">
									<img src="/images/cards/grimm-principe-rana.png" alt="Carta El Príncipe Rana, del mazo Hermanos Grimm" />
								</div>
								<div class="deck-name">Grimm</div>
								<div class="deck-desc">Hansel y Gretel, Blancanieves, Rapunzel y más.</div>
							</div>
							<div class="badge-item">
								<div class="card-thumb">
									<img src="/images/cards/carroll-jardin-rosas.png" alt="Carta El Jardín de Rosas, del mazo País de las Maravillas" />
								</div>
								<div class="deck-name">Carroll</div>
								<div class="deck-desc">El Conejo Blanco, el Sombrerero Loco, el Gato de Cheshire.</div>
							</div>
							<div class="badge-item">
								<div class="card-thumb">
									<img src="/images/cards/piratas-kraken.png" alt="Carta El Kraken, del mazo Piratas" />
								</div>
								<div class="deck-name">Piratas</div>
								<div class="deck-desc">El capitán, el kraken, el mapa del tesoro y más.</div>
							</div>
							<div class="badge-item">
								<div class="card-thumb">
									<img src="/images/cards/griego-zeus.png" alt="Carta Zeus, del mazo Mitología Griega" />
								</div>
								<div class="deck-name">Griego</div>
								<div class="deck-desc">Zeus, Atenea, Medusa, el Minotauro y más.</div>
							</div>
							<div class="badge-item">
								<div class="card-thumb">
									<img src="/images/cards/muertos-fruta-temporada.png" alt="Carta La Fruta de Temporada, del mazo Día de Muertos" />
								</div>
								<div class="deck-name">Muertos</div>
								<div class="deck-desc">La Catrina, el Xoloitzcuintle, la Calaverita de Azúcar.</div>
							</div>
							<div class="badge-item">
								<div class="card-thumb">
									<img src="/images/cards/cyberpunk-androide.png" alt="Carta El Androide, del mazo Cyberpunk" />
								</div>
								<div class="deck-name">Cyberpunk</div>
								<div class="deck-desc">El hacker, el androide, la megaciudad y más.</div>
							</div>
							<div class="badge-item">
								<div class="card-thumb">
									<img src="/images/cards/terror-muneca.png" alt="Carta La Muñeca Embrujada, del mazo Terror Clásico" />
								</div>
								<div class="deck-name">Terror</div>
								<div class="deck-desc">El vampiro, el hombre lobo, la casa embrujada y más.</div>
							</div>
							<div class="badge-item">
								<div class="card-thumb">
									<img src="/images/cards/nordico-thor.png" alt="Carta Thor, del mazo Mitología Nórdica" />
								</div>
								<div class="deck-name">Nórdico</div>
								<div class="deck-desc">Odín, Thor, Loki, Fenrir y más.</div>
							</div>
						</div>
						<div class="badge-arrow">
							<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"
								><path d="M9 6l6 6-6 6"></path></svg
							>
						</div>
					</div>
				</div>
			</section>

			<!-- MAROON SHOWCASE -->
			<section class="checker-red section">
				<div class="mx-auto max-w-7xl px-[25px] sm:px-8 md:px-12 lg:px-16 showcase-split">
					<div class="showcase-shot">
						<img src="/images/cards/terror-muneca.png" alt="Carta La Muñeca Embrujada, del mazo Terror Clásico" />
					</div>
					<div>
						<div class="eyebrow eyebrow--light">Baraja destacada</div>
						<h2 class="pixel showcase-title">TERROR CLÁSICO</h2>
						<p class="showcase-copy">
							54 monstruos, objetos y lugares de terror clásico: el vampiro,
							el hombre lobo, la casa embrujada y más — una de las nueve
							barajas que puedes desbloquear.
						</p>
						<a href="#barajas" class="btn-pixel btn-pixel--gold-cta">Ver las 9 barajas</a>
					</div>
				</div>
			</section>

			<!-- BLUE MANIFESTO -->
			<section class="checker-blue section">
				<div class="mx-auto max-w-7xl px-[25px] sm:px-8 md:px-12 lg:px-16 center">
					<h2 class="pixel manifesto-title">SIN CUENTAS. SIN NUBE.<br />SIN LETRAS CHIQUITAS.</h2>
					<p class="manifesto-copy">Nada que registrar, nada que rastrear. Así de simple.</p>
					<div class="feature-grid feature-grid--wide">
						<div class="feature-card">
							<div class="feature-icon feature-icon--light">
								<svg width="32" height="32" viewBox="0 0 32 32"><path d="M30.48 16.76H32v12.19h-1.52Z" fill="currentColor"></path><path d="M28.95 28.95h1.53v1.53h-1.53Z" fill="currentColor"></path><path d="M28.95 15.24V3.05h-1.52V1.52h-1.52V0h-7.62v1.52h-1.53v1.53h-1.52v12.19h-1.52v1.52h16.76v-1.52Zm-3.04 0h-7.62V4.57h1.52V3.05h4.57v1.52h1.53Z" fill="currentColor"></path><path d="M15.24 30.48h13.71V32H15.24Z" fill="currentColor"></path><path d="M24.38 22.86h1.53v1.52h-1.53Z" fill="currentColor"></path><path d="M24.38 19.81h1.53v1.52h-1.53Z" fill="currentColor"></path><path d="M19.81 24.38h4.57v1.52h-4.57Z" fill="currentColor"></path><path d="M18.29 22.86h1.52v1.52h-1.52Z" fill="currentColor"></path><path d="M18.29 19.81h1.52v1.52h-1.52Z" fill="currentColor"></path><path d="M13.72 28.95h1.52v1.53h-1.52Z" fill="currentColor"></path><path d="M12.19 16.76h1.53v4.57h-1.53Z" fill="currentColor"></path><path d="M10.67 22.86h1.52v6.09h-1.52Z" fill="currentColor"></path><path d="M9.15 28.95h1.52v1.53H9.15Z" fill="currentColor"></path><path d="M9.15 21.33h1.52v1.53H9.15Z" fill="currentColor"></path><path d="M7.62 6.09h1.53v15.24H7.62Z" fill="currentColor"></path><path d="M3.05 30.48h6.1V32h-6.1Z" fill="currentColor"></path><path d="m7.62 22.86 -3.05 0 0 1.52 -1.52 0 0 3.05 1.52 0 0 1.52 3.05 0 0 -1.52 1.53 0 0 -3.05 -1.53 0 0 -1.52z" fill="currentColor"></path><path d="M4.57 4.57h3.05v1.52H4.57Z" fill="currentColor"></path><path d="m4.57 16.76 -3.04 0 0 -1.52 3.04 0 0 -4.57 -3.04 0 0 -1.53 3.04 0 0 -3.05 -1.52 0 0 1.53 -3.05 0 0 4.57 3.05 0 0 1.52 -3.05 0 0 4.57 3.05 0 0 3.05 1.52 0 0 -4.57z" fill="currentColor"></path><path d="M1.53 28.95h1.52v1.53H1.53Z" fill="currentColor"></path><path d="M1.53 21.33h1.52v1.53H1.53Z" fill="currentColor"></path><path d="M0 22.86h1.53v6.09H0Z" fill="currentColor"></path></svg>
							</div>
							<div class="feature-title pixel feature-title--light">Cero cuentas</div>
							<div class="feature-copy feature-copy--light">
								No hay login ni base de datos con tu nombre.
							</div>
						</div>
						<div class="feature-card">
							<div class="feature-icon feature-icon--light">
								<svg width="32" height="32" viewBox="0 0 32 32"><path d="M30.48 7.62H32v10.66h-1.52Z" fill="currentColor"></path><path d="M28.95 18.28h1.53v1.53h-1.53Z" fill="currentColor"></path><path d="M28.95 6.09h1.53v1.53h-1.53Z" fill="currentColor"></path><path d="M19.81 19.81h9.14v1.52h-9.14Z" fill="currentColor"></path><path d="M25.91 10.67h1.52v4.57h-1.52Z" fill="currentColor"></path><path d="M19.81 9.14h6.1v1.53h-6.1Z" fill="currentColor"></path><path d="M19.81 15.24h6.1v1.52h-6.1Z" fill="currentColor"></path><path d="M19.81 4.57h9.14v1.52h-9.14Z" fill="currentColor"></path><path d="M18.29 16.76h1.52v3.05h-1.52Z" fill="currentColor"></path><path d="M18.29 6.09h1.52v3.05h-1.52Z" fill="currentColor"></path><path d="M15.24 21.33h1.52v3.05h-1.52Z" fill="currentColor"></path><path d="M13.72 24.38h1.52v1.52h-1.52Z" fill="currentColor"></path><path d="M12.19 19.81h3.05v1.52h-3.05Z" fill="currentColor"></path><path d="M13.72 1.52h1.52v4.57h-1.52Z" fill="currentColor"></path><path d="M12.19 25.9h1.53v1.53h-1.53Z" fill="currentColor"></path><path d="M10.67 27.43h1.52v1.52h-1.52Z" fill="currentColor"></path><path d="M10.67 21.33h1.52v1.53h-1.52Z" fill="currentColor"></path><path d="M9.15 22.86h1.52v1.52H9.15Z" fill="currentColor"></path><path d="M9.15 15.24h1.52v3.04H9.15Z" fill="currentColor"></path><path d="M4.57 28.95h6.1v1.53h-6.1Z" fill="currentColor"></path><path d="M7.62 18.28h1.53v1.53H7.62Z" fill="currentColor"></path><path d="M6.1 13.71h3.05v1.53H6.1Z" fill="currentColor"></path><path d="M6.1 24.38h3.05v1.52H6.1Z" fill="currentColor"></path><path d="M6.1 19.81h1.52v1.52H6.1Z" fill="currentColor"></path><path d="M4.57 9.14h4.58v1.53H4.57Z" fill="currentColor"></path><path d="m4.57 3.05 3.05 0 0 3.04 3.05 0 0 3.05 1.52 0 0 -4.57 -3.04 0 0 -3.05 -4.58 0 0 1.53z" fill="currentColor"></path><path d="M4.57 21.33H6.1v3.05H4.57Z" fill="currentColor"></path><path d="M4.57 15.24H6.1v1.52H4.57Z" fill="currentColor"></path><path d="M3.05 27.43h1.52v1.52H3.05Z" fill="currentColor"></path><path d="M3.05 16.76h1.52v1.52H3.05Z" fill="currentColor"></path><path d="M1.53 25.9h1.52v1.53H1.53Z" fill="currentColor"></path><path d="M1.53 18.28h1.52v1.53H1.53Z" fill="currentColor"></path><path d="M0 19.81h1.53v6.09H0Z" fill="currentColor"></path></svg>
							</div>
							<div class="feature-title pixel feature-title--light">Anuncios opcionales</div>
							<div class="feature-copy feature-copy--light">
								Solo si tú decides ver uno, nunca a mitad de partida.
							</div>
						</div>
						<div class="feature-card">
							<div class="feature-icon feature-icon--light">
								<svg width="32" height="32" viewBox="0 0 32 32"><path d="M6.855 1.52h-1.52v28.96h1.52V32h18.29v-1.52h1.52V1.52h-1.52V0H6.855Zm9.15 0h3.04v1.53h-3.04Zm-3.05 0h1.52v1.53h-1.52Zm7.62 3.05V3.05h4.57v25.9H6.855V3.05h4.57v1.52Z" fill="currentColor"></path><path d="M22.095 22.86h1.52v3.05h-1.52Z" fill="currentColor"></path><path d="M22.095 7.62h1.52v3.05h-1.52Z" fill="currentColor"></path><path d="M20.575 15.24h1.52v4.57h-1.52Z" fill="currentColor"></path><path d="M20.575 12.19h1.52v1.52h-1.52Z" fill="currentColor"></path><path d="M19.045 6.1h3.05v1.52h-3.05Z" fill="currentColor"></path><path d="M19.045 25.91h3.05v1.52h-3.05Z" fill="currentColor"></path><path d="M19.045 10.67h1.53v1.52h-1.53Z" fill="currentColor"></path><path d="M17.525 18.29h1.52v4.57h-1.52Z" fill="currentColor"></path><path d="M17.525 13.71h1.52v3.05h-1.52Z" fill="currentColor"></path><path d="M16.005 9.14h3.04v1.53h-3.04Z" fill="currentColor"></path><path d="M12.955 22.86h4.57v1.52h-4.57Z" fill="currentColor"></path><path d="M14.475 18.29h1.53v1.52h-1.53Z" fill="currentColor"></path><path d="M14.475 12.19h3.05v1.52h-3.05Z" fill="currentColor"></path><path d="M12.955 13.71h1.52v4.58h-1.52Z" fill="currentColor"></path><path d="M12.955 9.14h1.52v1.53h-1.52Z" fill="currentColor"></path><path d="M11.425 21.33h1.53v1.53h-1.53Z" fill="currentColor"></path><path d="M11.425 10.67h1.53v1.52h-1.53Z" fill="currentColor"></path><path d="M9.905 6.1h3.05v1.52h-3.05Z" fill="currentColor"></path><path d="M9.905 25.91h3.05v1.52h-3.05Z" fill="currentColor"></path><path d="M9.905 19.81h1.52v1.52h-1.52Z" fill="currentColor"></path><path d="M9.905 12.19h1.52v6.1h-1.52Z" fill="currentColor"></path><path d="M8.385 22.86h1.52v3.05h-1.52Z" fill="currentColor"></path><path d="M8.385 7.62h1.52v3.05h-1.52Z" fill="currentColor"></path></svg>
							</div>
							<div class="feature-title pixel feature-title--light">Todo en tu teléfono</div>
							<div class="feature-copy feature-copy--light">
								Nada se guarda en servidores nuestros.
							</div>
						</div>
						<div class="feature-card">
							<div class="feature-icon feature-icon--light">
								<svg width="32" height="32" viewBox="0 0 32 32"><path d="M30.48 18.285H32v1.53h-1.52Z" fill="currentColor"></path><path d="M27.43 16.765h3.05v1.52h-3.05Z" fill="currentColor"></path><path d="M27.43 13.715h1.52v1.53h-1.52Z" fill="currentColor"></path><path d="m22.86 15.245 0 -3.05 -1.52 0 0 -1.53 -1.53 0 0 -3.04 1.53 0 0 -1.53 6.09 0 0 1.53 1.52 0 0 6.09 1.53 0 0 -9.14 -1.53 0 0 -1.53 -1.52 0 0 -1.52 -6.09 0 0 1.52 -1.53 0 0 1.53 -1.52 0 0 4.57 -4.57 0 0 -4.57 -1.53 0 0 -1.53 -1.52 0 0 -1.52 -6.1 0 0 1.52 -1.52 0 0 1.53 -1.52 0 0 9.14 1.52 0 0 -6.09 1.52 0 0 -1.53 6.1 0 0 1.53 1.52 0 0 3.04 -1.52 0 0 1.53 -1.52 0 0 3.05 -4.58 0 0 1.52 4.58 0 0 6.09 1.52 0 0 -7.61 1.52 0 0 -1.53 7.62 0 0 1.53 1.53 0 0 7.61 1.52 0 0 -6.09 4.57 0 0 -1.52 -4.57 0z" fill="currentColor"></path><path d="M24.38 28.955h1.53v1.52h-1.53Z" fill="currentColor"></path><path d="M22.86 27.435h1.52v1.52h-1.52Z" fill="currentColor"></path><path d="M19.81 25.905h3.05v1.53h-3.05Z" fill="currentColor"></path><path d="M19.81 22.855h1.53v1.53h-1.53Z" fill="currentColor"></path><path d="M18.29 16.765h1.52v3.05h-1.52Z" fill="currentColor"></path><path d="M12.19 24.385h7.62v1.52h-7.62Z" fill="currentColor"></path><path d="M13.72 21.335h4.57v1.52h-4.57Z" fill="currentColor"></path><path d="M12.19 16.765h1.53v3.05h-1.53Z" fill="currentColor"></path><path d="M10.67 22.855h1.52v1.53h-1.52Z" fill="currentColor"></path><path d="M9.15 25.905h3.04v1.53H9.15Z" fill="currentColor"></path><path d="M7.62 27.435h1.53v1.52H7.62Z" fill="currentColor"></path><path d="M6.1 28.955h1.52v1.52H6.1Z" fill="currentColor"></path><path d="M3.05 13.715h1.52v1.53H3.05Z" fill="currentColor"></path><path d="M1.53 16.765h3.04v1.52H1.53Z" fill="currentColor"></path><path d="M0 18.285h1.53v1.53H0Z" fill="currentColor"></path></svg>
							</div>
							<div class="feature-title pixel feature-title--light">Pensada para todos</div>
							<div class="feature-copy feature-copy--light">
								Alto contraste, texto grande y voz en off.
							</div>
						</div>
					</div>
				</div>
			</section>

			<!-- GREEN CTA OVER PHOTO -->
			<section class="cta-photo">
				<img src="/images/2-sala-de-espera.png" alt="" />
				<div class="overlay">
					<h2 class="pixel cta-title">REÚNE A TU MESA</h2>
					<p class="cta-copy">
						Cada quien con su teléfono, todos en la misma red. Así se juega
						lotería en Pixotería.
					</p>
					<span class="btn-pixel btn-pixel--green btn-pixel--static">Próximamente en tu tienda</span>
				</div>
			</section>

			<!-- 9 BARAJAS, DE CERCA -->
			<section class="section" id="barajas">
				<div class="mx-auto max-w-7xl px-[25px] sm:px-8 md:px-12 lg:px-16">
					<div class="center">
						<div class="eyebrow">Nueve mundos, una lotería</div>
						<h2 class="heading-lg">Las 9 barajas, de cerca</h2>
						<p class="body-copy centered-copy">
							54 personajes y objetos por baraja — el clásico incluido, y ocho
							más para desbloquear.
						</p>
					</div>

